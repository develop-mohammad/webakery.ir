<?xml version="1.0"?>
<ruleset name="webakery">
	<description>WordPress coding standards for webakery.ir plugins.</description>

	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/wp-test/*</exclude-pattern>
	<exclude-pattern>*/visual-tests/*</exclude-pattern>
	<exclude-pattern>license-server/*</exclude-pattern>
	<exclude-pattern>*/class-wb-license.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<!-- Persian UI strings and RTL markup make the WP inline-comment and long-line rules noisy. -->
		<exclude name="Squiz.Commenting.FileComment"/>
		<exclude name="Squiz.Commenting.ClassComment"/>
		<exclude name="Squiz.Commenting.FunctionComment"/>
		<exclude name="Squiz.Commenting.VariableComment"/>
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="5.8"/>

	<!-- The expected text domain is per plugin, so bin/lint.sh sets it at runtime instead of hardcoding a list here. -->
</ruleset>
