# کپی در n8n → Settings → Variables  یا در docker .env

# گوگل شیت
SHEET_ID=
SHEET_TAB=Sheet1
COL_CATEGORY=دسته
COL_TITLE=عنوان
COL_KEYWORDS=کیورد اصلی
COL_LSI=کیورد فرعی
COL_BRAND=برند
COL_DONE=انجام شد
COL_DATE=تاریخ
COL_NOTE=یادداشت

# هوش مصنوعی سازگار با OpenAI (آوال‌ای / لیارا / OpenAI)
AI_BASE=https://api.openai.com/v1
AI_KEY=
AI_MODEL=gpt-4o-mini

# سایت وردپرس — از بیرون با Application Password
WP_URL=https://example.com
WP_USER=
WP_APP_PASSWORD=
WP_TAXONOMY=product_cat

BRAND_DEFAULT=
MIN_HUMAN_SCORE=78
BLOCKS_PER_RUN=1
TZ=Asia/Tehran

# فقط برای worker پایتون (اگر n8n ندارید)
# JSON حساب سرویس گوگل در یک خط، یا مسیر فایل
GOOGLE_SERVICE_ACCOUNT_FILE=
# یا وب‌اپ Apps Script برای زدن تیک و تاریخ
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
